        const squareMeshes = {}; // e.g., 'e4' -> THREE.Mesh

        function buildChessboard() {
            // Heavy Carved Obsidian & Gold Border Frame
            const frameGeo = new THREE.BoxGeometry(8 * SQUARE_SIZE + 1.8, 0.55, 8 * SQUARE_SIZE + 1.8);
            const frameMesh = new THREE.Mesh(frameGeo, matDarkPillar);
            frameMesh.position.y = -0.32;
            frameMesh.receiveShadow = true;
            boardGroup.add(frameMesh);

            const trimGeo = new THREE.BoxGeometry(8 * SQUARE_SIZE + 0.5, 0.6, 8 * SQUARE_SIZE + 0.5);
            const trimMesh = new THREE.Mesh(trimGeo, matMarbleTrim);
            trimMesh.position.y = -0.3;
            boardGroup.add(trimMesh);

            const files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
            const tileGeo = new THREE.BoxGeometry(SQUARE_SIZE * 0.98, 0.32, SQUARE_SIZE * 0.98);

            for (let r = 0; r < 8; r++) {
                for (let f = 0; f < 8; f++) {
                    const isLight = (r + f) % 2 === 0;
                    const squareName = `${files[f]}${8 - r}`;
                    const tileMesh = new THREE.Mesh(tileGeo, isLight ? matLightTile : matDarkTile);

                    const pos = squareToWorld(squareName);
                    tileMesh.position.set(pos.x, -0.16, pos.z);
                    tileMesh.receiveShadow = true;
                    tileMesh.userData = { square: squareName, isLight };

                    boardGroup.add(tileMesh);
                    squareMeshes[squareName] = tileMesh;
                }
            }
        }

        function squareToWorld(square) {
            const fileIndex = square.charCodeAt(0) - 97; // 'a' -> 0
            const rankIndex = 8 - parseInt(square[1], 10); // '8' -> 0, '1' -> 7
            return new THREE.Vector3(
                fileIndex * SQUARE_SIZE - BOARD_OFFSET,
                0,
                rankIndex * SQUARE_SIZE - BOARD_OFFSET
            );
        }

