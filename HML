<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Wizard's Chess — Minimalist Gothic Sanctuary</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Cinzel for Gothic/Material blend, plus Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0" rel="stylesheet" />
    <!-- Three.js r128 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Chess.js for complete legal 32-piece rules, check/checkmate, castling & en-passant -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
    <!-- Tone.js for procedural stone slide, clash, and shatter acoustics -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

    <style>
        :root {
            --md-surface: rgba(22, 24, 34, 0.82);
            --md-surface-high: rgba(34, 38, 52, 0.92);
            --md-primary: #d0bcff;
            --md-on-primary: #381e72;
            --md-outline: rgba(255, 255, 255, 0.12);
        }
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #0b0d14;
            font-family: 'Inter', sans-serif;
            color: #e6e1e5;
        }
        .font-gothic {
            font-family: 'Cinzel', serif;
        }
        #canvas-container {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
            cursor: grab;
        }
        canvas:active {
            cursor: grabbing;
        }
        /* Material Design 3 Glassmorphic Surface */
        .md-surface {
            background: var(--md-surface);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--md-outline);
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.6), 0 4px 12px -2px rgba(0, 0, 0, 0.4);
        }
        .md-btn {
            position: relative;
            overflow: hidden;
            transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
        }
        .md-btn:hover {
            background: rgba(208, 188, 255, 0.14);
            transform: translateY(-1px);
        }
        .md-btn:active {
            transform: translateY(0px) scale(0.97);
        }
        .md-btn-active {
            background: rgba(208, 188, 255, 0.22);
            color: #eaddff;
            border-color: rgba(208, 188, 255, 0.45);
        }
        /* Custom Scrollbar for Move Log */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(208, 188, 255, 0.3);
            border-radius: 9999px;
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
            50% { box-shadow: 0 0 16px 4px rgba(239, 68, 68, 0.75); }
        }
        .check-alert {
            animation: pulseGlow 1.6s infinite;
        }
    </style>
</head>
<body class="relative">

    <!-- 3D WebGL Viewport -->
    <div id="canvas-container"></div>

    <!-- Top Status Banner (Non-interactive HUD) -->
    <div class="fixed top-4 left-1/2 -translate-x-1/2 z-20 pointer-events-none flex flex-col items-center gap-2 w-[92%] max-w-xl">
        <div class="md-surface px-5 py-2.5 rounded-full flex items-center justify-between gap-4 w-full pointer-events-auto">
            <!-- Brand & Turn Indicator -->
            <div class="flex items-center gap-3">
                <div id="turn-swatch" class="w-4 h-4 rounded-full bg-stone-100 border-2 border-amber-300 shadow-[0_0_10px_rgba(255,255,255,0.8)] transition-all duration-300"></div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-gothic text-xs tracking-widest uppercase text-purple-200/80">Wizard's Chess</span>
                        <span id="mode-badge" class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-200 border border-purple-400/30">vs Automaton</span>
                    </div>
                    <p id="status-text" class="text-sm font-semibold text-white tracking-tight">White Marble's Turn</p>
                </div>
            </div>

            <!-- Captured Pieces Counters -->
            <div class="flex items-center gap-3 text-xs">
                <div class="flex items-center gap-1.5 bg-white/5 px-2.5 py-1 rounded-full border border-white/10" title="Shattered Obsidian Pieces">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-950 border border-purple-400 inline-block"></span>
                    <span id="captured-b" class="font-mono font-semibold text-purple-200">0</span>
                </div>
                <div class="flex items-center gap-1.5 bg-white/5 px-2.5 py-1 rounded-full border border-white/10" title="Shattered Marble Pieces">
                    <span class="w-2.5 h-2.5 rounded-full bg-stone-100 border border-amber-300 inline-block"></span>
                    <span id="captured-w" class="font-mono font-semibold text-amber-100">0</span>
                </div>
            </div>
        </div>

        <!-- Check / Battle Commentary Toast -->
        <div id="battle-toast" class="hidden md-surface px-4 py-1.5 rounded-full text-xs font-medium text-amber-200 border border-amber-400/30 shadow-lg transition-all duration-300">
            Obsidian Knight charges to D4!
        </div>
    </div>

    <!-- Collapsible Move Log Drawer (Toggled directly from Single-Level Bottom Bar) -->
    <div id="log-drawer" class="fixed bottom-24 right-4 sm:right-8 z-20 w-72 sm:w-80 max-h-72 md-surface rounded-3xl p-4 flex flex-col gap-2 transition-all duration-300 opacity-0 translate-y-4 pointer-events-none">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
            <div class="flex items-center gap-2">
                <span class="material-symbols-rounded text-purple-300 text-lg">history_edu</span>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-purple-100">Chronicle of Moves</h3>
            </div>
            <span id="move-count-badge" class="text-[11px] font-mono text-gray-400">0 turns</span>
        </div>
        <div id="move-list" class="overflow-y-auto flex-1 pr-1 space-y-1 text-xs font-mono text-gray-300 max-h-44">
            <div class="text-gray-500 italic py-4 text-center font-sans">Select any glowing marble piece to begin the duel.</div>
        </div>
        <div class="pt-1 border-t border-white/10 flex items-center justify-between text-[11px] text-gray-400">
            <span>Drag scene to orbit</span>
            <span>Scroll to zoom</span>
        </div>
    </div>

    <!-- Pawn Promotion Modal (Material Dialog) -->
    <div id="promotion-modal" class="fixed inset-0 z-40 bg-black/70 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="md-surface rounded-3xl p-6 max-w-sm w-full border border-purple-400/30 text-center space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-purple-500/20 border border-purple-400/40 flex items-center justify-center mx-auto text-purple-200">
                <span class="material-symbols-rounded text-2xl">auto_awesome</span>
            </div>
            <h2 class="font-gothic text-lg font-bold text-white">Ascension Ritual</h2>
            <p class="text-xs text-gray-300">Your pawn has reached the cathedral sanctum. Choose its transfigured form:</p>
            <div class="grid grid-cols-2 gap-2.5 pt-2">
                <button onclick="completePromotion('q')" class="md-btn p-3 rounded-2xl bg-white/5 border border-white/10 flex flex-col items-center gap-1 text-white">
                    <span class="material-symbols-rounded text-amber-300">crown</span>
                    <span class="text-xs font-semibold">Queen</span>
                </button>
                <button onclick="completePromotion('r')" class="md-btn p-3 rounded-2xl bg-white/5 border border-white/10 flex flex-col items-center gap-1 text-white">
                    <span class="material-symbols-rounded text-purple-300">castle</span>
                    <span class="text-xs font-semibold">Rook</span>
                </button>
                <button onclick="completePromotion('b')" class="md-btn p-3 rounded-2xl bg-white/5 border border-white/10 flex flex-col items-center gap-1 text-white">
                    <span class="material-symbols-rounded text-sky-300">church</span>
                    <span class="text-xs font-semibold">Bishop</span>
                </button>
                <button onclick="completePromotion('n')" class="md-btn p-3 rounded-2xl bg-white/5 border border-white/10 flex flex-col items-center gap-1 text-white">
                    <span class="material-symbols-rounded text-emerald-300">bedroom_baby</span>
                    <span class="text-xs font-semibold">Knight</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Game Over Modal -->
    <div id="gameover-modal" class="fixed inset-0 z-40 bg-black/75 backdrop-blur-md hidden items-center justify-center p-4">
        <div class="md-surface rounded-3xl p-6 max-w-sm w-full border border-amber-400/40 text-center space-y-4">
            <div class="w-14 h-14 rounded-2xl bg-amber-500/20 border border-amber-300/40 flex items-center justify-center mx-auto text-amber-200">
                <span class="material-symbols-rounded text-3xl">emoji_events</span>
            </div>
            <h2 id="gameover-title" class="font-gothic text-xl font-bold text-white">Checkmate</h2>
            <p id="gameover-desc" class="text-xs text-gray-300 leading-relaxed">White Marble triumphs in the Gothic Sanctuary.</p>
            <div class="pt-2 flex gap-3">
                <button onclick="closeGameOverModal()" class="md-btn flex-1 py-2.5 px-4 rounded-full border border-white/15 text-xs font-semibold text-gray-200">
                    Inspect Board
                </button>
                <button onclick="resetGame()" class="md-btn flex-1 py-2.5 px-4 rounded-full bg-purple-300 text-purple-950 text-xs font-bold shadow-lg">
                    New Duel
                </button>
            </div>
        </div>
    </div>

    <!-- Single-Level Material Design 3 Bottom Navigation Bar -->
    <nav aria-label="Game Controls" class="fixed bottom-4 left-1/2 -translate-x-1/2 z-30 w-[95%] max-w-2xl">
        <div class="md-surface rounded-full px-3 py-2 flex items-center justify-between sm:justify-around gap-1 sm:gap-2">
            
            <!-- New Game -->
            <button id="btn-new" onclick="resetGame()" class="md-btn flex items-center gap-2 px-3.5 py-2.5 rounded-full text-xs font-medium text-gray-100 border border-transparent" title="Reset Sanctuary Board">
                <span class="material-symbols-rounded text-[20px] text-purple-300">restart_alt</span>
                <span class="hidden sm:inline">New Game</span>
            </button>

            <!-- Camera Preset Cycle -->
            <button id="btn-camera" onclick="cycleCameraPreset()" class="md-btn flex items-center gap-2 px-3.5 py-2.5 rounded-full text-xs font-medium text-gray-100 border border-transparent" title="Cycle Camera Angle">
                <span class="material-symbols-rounded text-[20px] text-sky-300">videocam</span>
                <span id="camera-label" class="hidden sm:inline">White View</span>
            </button>

            <!-- Toggle AI vs 2-Player -->
            <button id="btn-mode" onclick="toggleGameMode()" class="md-btn md-btn-active flex items-center gap-2 px-3.5 py-2.5 rounded-full text-xs font-medium border" title="Switch Opponent Mode">
                <span id="mode-icon" class="material-symbols-rounded text-[20px]">smart_toy</span>
                <span id="mode-label" class="hidden sm:inline">vs Wizard AI</span>
            </button>

            <!-- Shatter Demo / Hint -->
            <button id="btn-hint" onclick="triggerTacticalHint()" class="md-btn flex items-center gap-2 px-3.5 py-2.5 rounded-full text-xs font-medium text-gray-100 border border-transparent" title="Highlight Tactical Move">
                <span class="material-symbols-rounded text-[20px] text-amber-300">wand_stars</span>
                <span class="hidden sm:inline">Arcane Hint</span>
            </button>

            <!-- Audio Toggle -->
            <button id="btn-audio" onclick="toggleAudio()" class="md-btn flex items-center gap-2 px-3.5 py-2.5 rounded-full text-xs font-medium text-gray-100 border border-transparent" title="Toggle Cathedral Acoustics">
                <span id="audio-icon" class="material-symbols-rounded text-[20px] text-emerald-300">volume_up</span>
                <span class="hidden sm:inline">Audio</span>
            </button>

            <!-- Move Log Drawer Toggle -->
            <button id="btn-log" onclick="toggleLogDrawer()" class="md-btn flex items-center gap-2 px-3.5 py-2.5 rounded-full text-xs font-medium text-gray-100 border border-transparent" title="Toggle Move Chronicle">
                <span class="material-symbols-rounded text-[20px] text-pink-300">receipt_long</span>
                <span class="hidden sm:inline">Moves</span>
            </button>
        </div>
    </nav>

    <script>
        /***********************************************************************
         * 1. PROCEDURAL CATHEDRAL ACOUSTICS (TONE.JS)
         * Generates stone sliding, sword/staff strikes, and shattering debris
         * without requiring any external audio files.
         ***********************************************************************/
        let soundEnabled = true;
        let audioInitialized = false;
        let slideSynth, impactSynth, shatterNoise, choirSynth;

        async function initAudio() {
            if (audioInitialized || !soundEnabled) return;
            try {
                await Tone.start();
                const reverb = new Tone.Reverb({ decay: 4.5, preDelay: 0.08, wet: 0.55 }).toDestination();
                await reverb.generate();

                // Deep resonant stone slide
                slideSynth = new Tone.MembraneSynth({
                    pitchDecay: 0.08,
                    octaves: 2,
                    envelope: { attack: 0.02, decay: 0.35, sustain: 0.0, release: 0.3 }
                }).connect(reverb);
                slideSynth.volume.value = -10;

                // Metallic/arcane weapon strike
                impactSynth = new Tone.MetalSynth({
                    frequency: 180,
                    envelope: { attack: 0.002, decay: 0.35, release: 0.2 },
                    harmonicity: 4.1,
                    modulationIndex: 24,
                    resonance: 2200,
                    octaves: 1.2
                }).connect(reverb);
                impactSynth.volume.value = -12;

                // Stone & Obsidian fragmentation noise burst
                shatterNoise = new Tone.NoiseSynth({
                    noise: { type: 'pink' },
                    envelope: { attack: 0.005, decay: 0.45, sustain: 0 }
                }).connect(reverb);
                shatterNoise.volume.value = -8;

                // Cathedral Chime for Check/Victory
                choirSynth = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: 'triangle' },
                    envelope: { attack: 0.04, decay: 0.8, sustain: 0.2, release: 1.8 }
                }).connect(reverb);
                choirSynth.volume.value = -12;

                audioInitialized = true;
            } catch (e) {
                console.warn("Audio initialization skipped:", e);
            }
        }

        function playSound(type) {
            if (!soundEnabled) return;
            if (!audioInitialized) initAudio();
            if (!audioInitialized) return;

            try {
                const now = Tone.now();
                if (type === 'select') {
                    choirSynth.triggerAttackRelease(['E5'], 0.12, now);
                } else if (type === 'move') {
                    slideSynth.triggerAttackRelease('C2', '8n', now);
                    slideSynth.triggerAttackRelease('G1', '16n', now + 0.14);
                } else if (type === 'attack') {
                    impactSynth.triggerAttackRelease('C4', '16n', now);
                } else if (type === 'shatter') {
                    shatterNoise.triggerAttackRelease('8n', now);
                    slideSynth.triggerAttackRelease('D1', '4n', now + 0.03);
                    choirSynth.triggerAttackRelease(['C3', 'G3', 'Eb4'], 0.35, now + 0.05);
                } else if (type === 'check') {
                    choirSynth.triggerAttackRelease(['D4', 'A4', 'F5'], 0.7, now);
                } else if (type === 'victory') {
                    choirSynth.triggerAttackRelease(['C4', 'E4', 'G4', 'C5'], 1.6, now);
                }
            } catch (err) {
                // Ignore overlapping Tone scheduling edge cases
            }
        }

        function toggleAudio() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('audio-icon');
            icon.textContent = soundEnabled ? 'volume_up' : 'volume_off';
            icon.className = soundEnabled
                ? 'material-symbols-rounded text-[20px] text-emerald-300'
                : 'material-symbols-rounded text-[20px] text-gray-500';
            if (soundEnabled) playSound('select');
        }

        /***********************************************************************
         * 2. THREE.JS SCENE, MINIMALIST GOTHIC CATHEDRAL & STAINED GLASS LIGHT
         ***********************************************************************/
        let scene, camera, renderer, raycaster, mouse;
        const boardGroup = new THREE.Group();
        const piecesGroup = new THREE.Group();
        const highlightsGroup = new THREE.Group();
        const particlesGroup = new THREE.Group();
        const cathedralGroup = new THREE.Group();

        const SQUARE_SIZE = 2.2;
        const BOARD_OFFSET = (8 * SQUARE_SIZE) / 2 - SQUARE_SIZE / 2; // 7.7

        // Orbit Camera Control State
        let camSpherical = {
            radius: 25.5,
            theta: 0,           // Horizontal azimuth (0 = Behind White)
            phi: 0.92,          // Vertical polar angle
            targetRadius: 25.5,
            targetTheta: 0,
            targetPhi: 0.92,
            lookAt: new THREE.Vector3(0, 0.8, 0)
        };
        let cameraPresetIndex = 0; // 0: White, 1: Black, 2: Gothic Isometric, 3: Top-Down Sanctum
        let isDragging = false;
        let dragMoved = false;
        let pointerDownPos = { x: 0, y: 0 };
        let prevPointerPos = { x: 0, y: 0 };

        // Shared Materials
        let matMarblePiece, matObsidianPiece, matMarbleTrim, matObsidianTrim;
        let matLightTile, matDarkTile, matCathedralStone, matDarkPillar;
        let stainedGlassLights = [];

        function initThreeScene() {
            const container = document.getElementById('canvas-container');
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0b0d14);
            scene.fog = new THREE.FogExp2(0x0b0d14, 0.0145);

            camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 180);

            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.15;
            container.appendChild(renderer.domElement);

            raycaster = new THREE.Raycaster();
            mouse = new THREE.Vector2();

            initMaterials();
            buildGothicCathedral();
            buildChessboard();
            setupCathedralLighting();

            scene.add(cathedralGroup);
            scene.add(boardGroup);
            scene.add(highlightsGroup);
            scene.add(piecesGroup);
            scene.add(particlesGroup);

            bindViewportEvents(renderer.domElement);
            window.addEventListener('resize', onWindowResize);
        }

        function initMaterials() {
            // Sculpted White Carrara Marble with warm subsurface sheen
            matMarblePiece = new THREE.MeshStandardMaterial({
                color: 0xf4f1ea,
                roughness: 0.22,
                metalness: 0.08,
                emissive: 0x241c14,
                emissiveIntensity: 0.12
            });

            // Glowing Gold Runic Trim for White Marble
            matMarbleTrim = new THREE.MeshStandardMaterial({
                color: 0xfbbf24,
                roughness: 0.25,
                metalness: 0.85,
                emissive: 0xf59e0b,
                emissiveIntensity: 0.45
            });

            // Volcanic Dark Obsidian with high specular reflection
            matObsidianPiece = new THREE.MeshStandardMaterial({
                color: 0x151320,
                roughness: 0.12,
                metalness: 0.55,
                emissive: 0x160d2e,
                emissiveIntensity: 0.28
            });

            // Arcane Amethyst Trim for Obsidian Pieces
            matObsidianTrim = new THREE.MeshStandardMaterial({
                color: 0xa855f7,
                roughness: 0.2,
                metalness: 0.8,
                emissive: 0x9333ea,
                emissiveIntensity: 0.75
            });

            // Board Tiles
            matLightTile = new THREE.MeshStandardMaterial({
                color: 0xd8d3c8,
                roughness: 0.28,
                metalness: 0.1
            });
            matDarkTile = new THREE.MeshStandardMaterial({
                color: 0x1f2230,
                roughness: 0.22,
                metalness: 0.35
            });

            // Minimalist Gothic Architecture Stone
            matCathedralStone = new THREE.MeshStandardMaterial({
                color: 0x181b26,
                roughness: 0.82,
                metalness: 0.12
            });
            matDarkPillar = new THREE.MeshStandardMaterial({
                color: 0x12151f,
                roughness: 0.7,
                metalness: 0.2
            });
        }

        /***********************************************************************
         * 3. MINIMALIST GOTHIC CATHEDRAL ARCHITECTURE
         * Pointed lancet arches, ribbed vaults, clustered colonnades, rose window,
         * and luminous stained-glass light beams.
         ***********************************************************************/
        function buildGothicCathedral() {
            // Nave Sanctuary Floor with subtle concentric stone inlay
            const floorGeo = new THREE.CylinderGeometry(58, 58, 0.6, 64);
            const floorMesh = new THREE.Mesh(floorGeo, matCathedralStone);
            floorMesh.position.y = -1.6;
            floorMesh.receiveShadow = true;
            cathedralGroup.add(floorMesh);

            // Raised Octagonal Dais / Altar Pedestal under the Chessboard
            const daisGeo = new THREE.CylinderGeometry(14.5, 16.2, 1.2, 8);
            const daisMesh = new THREE.Mesh(daisGeo, matDarkPillar);
            daisMesh.position.y = -0.9;
            daisMesh.rotation.y = Math.PI / 8;
            daisMesh.receiveShadow = true;
            cathedralGroup.add(daisMesh);

            // Glowing Arcane Ring inlaid into the Dais
            const ringGeo = new THREE.RingGeometry(12.6, 13.0, 64);
            const ringMat = new THREE.MeshBasicMaterial({
                color: 0x8b5cf6,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.35
            });
            const ringMesh = new THREE.Mesh(ringGeo, ringMat);
            ringMesh.rotation.x = -Math.PI / 2;
            ringMesh.position.y = -0.28;
            cathedralGroup.add(ringMesh);

            // Construct 6 Bays of Clustered Gothic Pillars & Pointed Vault Arches
            const aisleX = 21;
            const baySpacing = 12;
            const stainedColors = [0xec4899, 0x3b82f6, 0xf59e0b, 0x8b5cf6, 0x06b6d4];

            for (let i = -2; i <= 2; i++) {
                const zPos = i * baySpacing;
                const glassColor = stainedColors[(i + 2) % stainedColors.length];

                // Left & Right Clustered Columns
                [-aisleX, aisleX].forEach((xSide, sideIdx) => {
                    const pillar = createClusteredPillar();
                    pillar.position.set(xSide, -1.3, zPos);
                    cathedralGroup.add(pillar);

                    // Tall Lancet Stained Glass Window behind the colonnade
                    const winGroup = createStainedGlassLancet(glassColor);
                    winGroup.position.set(xSide * 1.38, 10.5, zPos);
                    winGroup.rotation.y = sideIdx === 0 ? Math.PI / 2 : -Math.PI / 2;
                    cathedralGroup.add(winGroup);
                });

                // Transverse Pointed Gothic Vault Rib spanning across the nave
                const arch = createPointedGothicArch(aisleX * 2, 28);
                arch.position.set(0, 14, zPos);
                cathedralGroup.add(arch);
            }

            // North & South Apse Rose Windows high above the sanctuary
            [-34, 34].forEach((zEnd, idx) => {
                const rose = createRoseWindow(idx === 0 ? 0xa855f7 : 0xf59e0b);
                rose.position.set(0, 17.5, zEnd);
                if (idx === 1) rose.rotation.y = Math.PI;
                cathedralGroup.add(rose);
            });
        }

