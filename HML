        /***********************************************************************
         * 6. SHATTER PARTICLE ENGINE & ACTIVE PIECE ANIMATIONS
         * Handles Move Arcs, Melee Lunge/Impact Strikes, and Explosive Shattering
         * of captured Marble/Obsidian pieces with floor physics bounce.
         ***********************************************************************/
        const activeFragments = [];
        const activeShockwaves = [];
        let currentActionAnim = null; // Stores active move/attack sequence

        function spawnShatterExplosion(worldPos, pieceColor, impactDir) {
            playSound('shatter');
            const isWhite = pieceColor === 'w';
            const primaryMat = isWhite ? matMarblePiece : matObsidianPiece;
            const sparkMat = isWhite ? matMarbleTrim : matObsidianTrim;

            // Spawn 42 angular Voronoï-style stone/obsidian shards
            const shardCount = 42;
            for (let i = 0; i < shardCount; i++) {
                const isSpark = i % 4 === 0;
                const radius = isSpark ? 0.14 + Math.random() * 0.14 : 0.18 + Math.random() * 0.28;
                const shardGeo = new THREE.DodecahedronGeometry(radius, 0);
                const shardMesh = new THREE.Mesh(shardGeo, isSpark ? sparkMat : primaryMat);

                // non-uniform rock scaling
                shardMesh.scale.set(
                    0.6 + Math.random() * 0.9,
                    0.5 + Math.random() * 1.1,
                    0.6 + Math.random() * 0.9
                );

                shardMesh.position.set(
                    worldPos.x + (Math.random() - 0.5) * 0.8,
                    0.4 + Math.random() * 2.1,
                    worldPos.z + (Math.random() - 0.5) * 0.8
                );
                shardMesh.castShadow = true;

                // Explosive radial + directional knockback velocity
                const spreadAngle = Math.random() * Math.PI * 2;
                const radialSpeed = 2.5 + Math.random() * 6.5;
                const vel = new THREE.Vector3(
                    Math.cos(spreadAngle) * radialSpeed + impactDir.x * 4.5,
                    3.5 + Math.random() * 6.5,
                    Math.sin(spreadAngle) * radialSpeed + impactDir.z * 4.5
                );

                const rotVel = new THREE.Vector3(
                    (Math.random() - 0.5) * 14,
                    (Math.random() - 0.5) * 14,
                    (Math.random() - 0.5) * 14
                );

                particlesGroup.add(shardMesh);
                activeFragments.push({
                    mesh: shardMesh,
                    vel,
                    rotVel,
                    life: 0,
                    maxLife: 2.3 + Math.random() * 0.9
                });
            }

            // Arcane Shockwave Ring on the cathedral board
            const ringGeo = new THREE.RingGeometry(0.2, 0.55, 32);
            const ringMat = new THREE.MeshBasicMaterial({
                color: isWhite ? 0xfbbf24 : 0xa855f7,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.9
            });
            const ringMesh = new THREE.Mesh(ringGeo, ringMat);
            ringMesh.rotation.x = -Math.PI / 2;
            ringMesh.position.set(worldPos.x, 0.05, worldPos.z);
            particlesGroup.add(ringMesh);
            activeShockwaves.push({ mesh: ringMesh, life: 0, maxLife: 0.65 });
        }

        function updateParticlesAndPhysics(dt) {
            // Update shattered stone fragments with gravity & board bounce
            for (let i = activeFragments.length - 1; i >= 0; i--) {
                const frag = activeFragments[i];
                frag.life += dt;
                if (frag.life >= frag.maxLife) {
                    particlesGroup.remove(frag.mesh);
                    frag.mesh.geometry.dispose();
                    activeFragments.splice(i, 1);
                    continue;
                }

                // Gravity
                frag.vel.y -= 22.0 * dt;
                frag.mesh.position.addScaledVector(frag.vel, dt);

                // Floor bounce on the board surface
                if (frag.mesh.position.y < 0.12) {
                    frag.mesh.position.y = 0.12;
                    frag.vel.y *= -0.42;
                    frag.vel.x *= 0.72;
                    frag.vel.z *= 0.72;
                    frag.rotVel.multiplyScalar(0.65);
                }

                frag.mesh.rotation.x += frag.rotVel.x * dt;
                frag.mesh.rotation.y += frag.rotVel.y * dt;
                frag.mesh.rotation.z += frag.rotVel.z * dt;

                // Shrink out smoothly in the final 0.6s
                const remaining = frag.maxLife - frag.life;
                if (remaining < 0.6) {
                    const s = Math.max(0.01, remaining / 0.6);
                    frag.mesh.scale.multiplyScalar(0.95);
                }
            }

            // Update expanding arcane shockwaves
            for (let i = activeShockwaves.length - 1; i >= 0; i--) {
                const wave = activeShockwaves[i];
                wave.life += dt;
                const progress = wave.life / wave.maxLife;
                if (progress >= 1) {
                    particlesGroup.remove(wave.mesh);
                    wave.mesh.geometry.dispose();
                    wave.mesh.material.dispose();
                    activeShockwaves.splice(i, 1);
                    continue;
                }
                const scale = 1 + progress * 6.5;
                wave.mesh.scale.set(scale, scale, 1);
                wave.mesh.material.opacity = (1 - progress) * 0.85;
            }
        }

        /***********************************************************************
         * 7. CHESS ENGINE STATE, MOVE ANIMATION SEQUENCER & WIZARD AI
         ***********************************************************************/
        const chess = new Chess();
        const pieceMeshes = {}; // square -> THREE.Group
        let selectedSquare = null;
        let legalMovesForSelected = [];
        let pendingPromotionMove = null;
        let vsAI = true;
        let isAnimating = false;
        let capturedCounts = { w: 0, b: 0 };

        function syncBoardFromFEN() {
            // Clear existing 3D piece meshes
            while (piecesGroup.children.length > 0) {
                piecesGroup.remove(piecesGroup.children[0]);
            }
            Object.keys(pieceMeshes).forEach(k => delete pieceMeshes[k]);

            const board = chess.board();
            const files = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];

            for (let r = 0; r < 8; r++) {
                for (let f = 0; f < 8; f++) {
                    const cell = board[r][f];
                    if (cell) {
                        const sq = `${files[f]}${8 - r}`;
                        const mesh = createSculptedPiece(cell.type, cell.color);
                        const worldPos = squareToWorld(sq);
                        mesh.position.copy(worldPos);
                        mesh.userData.square = sq;
                        piecesGroup.add(mesh);
                        pieceMeshes[sq] = mesh;
                    }
                }
            }
        }

        function clearSquareHighlights() {
            while (highlightsGroup.children.length > 0) {
                const child = highlightsGroup.children[0];
                highlightsGroup.remove(child);
            }
        }

        function renderSquareHighlights() {
            clearSquareHighlights();

            // Highlight Selected Piece Square
            if (selectedSquare) {
                const pos = squareToWorld(selectedSquare);
                const selGeo = new THREE.RingGeometry(0.76, 0.96, 32);
                const selMat = new THREE.MeshBasicMaterial({
                    color: 0xfbbf24,
                    side: THREE.DoubleSide
                });
                const ring = new THREE.Mesh(selGeo, selMat);
                ring.rotation.x = -Math.PI / 2;
                ring.position.set(pos.x, 0.03, pos.z);
                highlightsGroup.add(ring);
            }

            // Highlight Legal Destination Squares
            legalMovesForSelected.forEach(move => {
                const pos = squareToWorld(move.to);
                const isCapture = move.flags.includes('c') || move.flags.includes('e');

                if (isCapture) {
                    // Crimson Target Reticle for Shatter Attack
                    const capGeo = new THREE.RingGeometry(0.72, 0.98, 6);
                    const capMat = new THREE.MeshBasicMaterial({
                        color: 0xf43f5e,
                        side: THREE.DoubleSide
                    });
                    const capRing = new THREE.Mesh(capGeo, capMat);
                    capRing.rotation.x = -Math.PI / 2;
                    capRing.position.set(pos.x, 0.04, pos.z);
                    highlightsGroup.add(capRing);
                } else {
                    // Luminous Arcane Sigil Dot for Standard Move
                    const dotGeo = new THREE.CircleGeometry(0.34, 24);
                    const dotMat = new THREE.MeshBasicMaterial({
                        color: 0x38bdf8,
                        transparent: true,
                        opacity: 0.85,
                        side: THREE.DoubleSide
                    });
                    const dot = new THREE.Mesh(dotGeo, dotMat);
                    dot.rotation.x = -Math.PI / 2;
                    dot.position.set(pos.x, 0.03, pos.z);
                    highlightsGroup.add(dot);
                }
            });

            // Highlight King in Check if applicable
            if (chess.in_check()) {
                const turnColor = chess.turn();
                Object.keys(pieceMeshes).forEach(sq => {
                    const pm = pieceMeshes[sq];
                    if (pm && pm.userData.type === 'k' && pm.userData.color === turnColor) {
                        const pos = squareToWorld(sq);
                        const chkGeo = new THREE.CircleGeometry(0.98, 32);
                        const chkMat = new THREE.MeshBasicMaterial({
                            color: 0xef4444,
                            transparent: true,
                            opacity: 0.55,
                            side: THREE.DoubleSide
                        });
                        const chkDisc = new THREE.Mesh(chkGeo, chkMat);
                        chkDisc.rotation.x = -Math.PI / 2;
                        chkDisc.position.set(pos.x, 0.025, pos.z);
                        highlightsGroup.add(chkDisc);
                    }
                });
            }
        }

        function onSquareClicked(square) {
            if (isAnimating || chess.game_over()) return;
            // If vs AI and it's Black's turn, block manual input
            if (vsAI && chess.turn() === 'b') return;

            // Check if clicked square is a legal destination for currently selected piece
            const chosenMove = legalMovesForSelected.find(m => m.to === square);
            if (chosenMove) {
                // Check if pawn promotion
                if (chosenMove.flags.includes('p')) {
                    pendingPromotionMove = { from: chosenMove.from, to: chosenMove.to };
                    const modal = document.getElementById('promotion-modal');
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                    return;
                }
                executeAnimatedMove(chosenMove);
                return;
            }

            // Otherwise, check if user clicked one of their own pieces
            const clickedPiece = chess.get(square);
            if (clickedPiece && clickedPiece.color === chess.turn()) {
                selectedSquare = square;
                legalMovesForSelected = chess.moves({ square, verbose: true });
                playSound('select');
                renderSquareHighlights();
            } else {
                selectedSquare = null;
                legalMovesForSelected = [];
                renderSquareHighlights();
            }
        }

        function completePromotion(promoteToPiece) {
            const modal = document.getElementById('promotion-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            if (!pendingPromotionMove) return;

            const moves = chess.moves({ square: pendingPromotionMove.from, verbose: true });
            const match = moves.find(
                m => m.to === pendingPromotionMove.to && m.promotion === promoteToPiece
            );
            pendingPromotionMove = null;
            if (match) {
                executeAnimatedMove(match);
            }
        }

        /***********************************************************************
         * 8. CUSTOM MOVE, ATTACK & SHATTER ANIMATION SEQUENCER
         * Animates the moving piece gliding/leaping across the board. On capture,
         * performs a dramatic wind-up lunge, strikes the defender, and triggers
         * the 3D shatter particle explosion!
         ***********************************************************************/
        function executeAnimatedMove(moveObj) {
            isAnimating = true;
            selectedSquare = null;
            legalMovesForSelected = [];
            clearSquareHighlights();

            const attackerMesh = pieceMeshes[moveObj.from];
            const isCapture = moveObj.flags.includes('c') || moveObj.flags.includes('e');

            // Determine captured square (handles En Passant where captured pawn is on adjacent rank)
            let defenderSquare = moveObj.to;
            if (moveObj.flags.includes('e')) {
                const file = moveObj.to[0];
                const rank = moveObj.color === 'w' ? '5' : '4';
                defenderSquare = `${file}${rank}`;
            }
            const defenderMesh = isCapture ? pieceMeshes[defenderSquare] : null;

            const startPos = squareToWorld(moveObj.from);
            const targetPos = squareToWorld(moveObj.to);
            const moveDir = new THREE.Vector3().subVectors(targetPos, startPos).normalize();

            // Commit move in chess.js engine
            const result = chess.move(moveObj);
            if (!result) {
                isAnimating = false;
                return;
            }

            playSound('move');
            const isKnight = moveObj.piece === 'n';
            const totalDuration = isCapture ? 0.92 : 0.56;

            currentActionAnim = {
                attackerMesh,
                defenderMesh,
                defenderSquare,
                moveObj: result,
                startPos,
                targetPos,
                moveDir,
                isCapture,
                isKnight,
                shatterTriggered: false,
                elapsed: 0,
                duration: totalDuration
            };
        }

        function updateActiveMoveAnimation(dt) {
            if (!currentActionAnim) return;
            const anim = currentActionAnim;
            anim.elapsed += dt;
            const t = Math.min(1, anim.elapsed / anim.duration);

            if (!anim.isCapture) {
                // Smooth ease-in-out glide (with high arc for Knights)
                const ease = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
                anim.attackerMesh.position.lerpVectors(anim.startPos, anim.targetPos, ease);

                if (anim.isKnight) {
                    anim.attackerMesh.position.y = Math.sin(t * Math.PI) * 2.8;
                } else {
                    anim.attackerMesh.position.y = Math.sin(t * Math.PI) * 0.35;
                }

                // Subtle forward lean during stone slide
                const lean = Math.sin(t * Math.PI) * 0.22;
                anim.attackerMesh.userData.bodyGroup.rotation.x = anim.moveObj.color === 'w' ? -lean : lean;

            } else {
                // COMBAT ATTACK & SHATTER CHOREOGRAPHY
                // Phase 1 (0.0 -> 0.58): Approach to striking distance just in front of defender
                // Phase 2 (0.58 -> 0.72): Wind-up & ferocious lunge strike -> Triggers Shatter!
                // Phase 3 (0.72 -> 1.0): Settle victoriously onto the conquered square
                const stopPoint = new THREE.Vector3().lerpVectors(anim.startPos, anim.targetPos, 0.76);

                if (t < 0.58) {
                    const p = t / 0.58;
                    const ease = p * p * (3 - 2 * p);
                    anim.attackerMesh.position.lerpVectors(anim.startPos, stopPoint, ease);
                    if (anim.isKnight) {
                        anim.attackerMesh.position.y = Math.sin(p * Math.PI) * 2.6;
                    }
                    // Rear back for strike near the end of approach
                    const windUp = Math.sin(p * Math.PI) * 0.32;
                    anim.attackerMesh.userData.bodyGroup.rotation.x = anim.moveObj.color === 'w' ? windUp : -windUp;
                } else if (t < 0.74) {
                    const p = (t - 0.58) / 0.16;
                    // Ferocious strike lunge into target
                    anim.attackerMesh.position.lerpVectors(stopPoint, anim.targetPos, p);
                    const strikeLean = Math.sin(p * Math.PI) * 0.58;
                    anim.attackerMesh.userData.bodyGroup.rotation.x = anim.moveObj.color === 'w' ? -strikeLean : strikeLean;

                    if (!anim.shatterTriggered && p >= 0.45) {
                        anim.shatterTriggered = true;
                        playSound('attack');
                        if (anim.defenderMesh) {
                            const defPos = anim.defenderMesh.position.clone();
                            const defColor = anim.defenderMesh.userData.color;
                            spawnShatterExplosion(defPos, defColor, anim.moveDir);
                            piecesGroup.remove(anim.defenderMesh);
                            delete pieceMeshes[anim.defenderSquare];

                            capturedCounts[defColor]++;
                            showBattleToast(anim.moveObj);
                        }
                    }
                } else {
                    const p = (t - 0.74) / 0.26;
                    anim.attackerMesh.position.copy(anim.targetPos);
                    anim.attackerMesh.position.y = 0;
                    anim.attackerMesh.userData.bodyGroup.rotation.x *= (1 - p);
                }
            }

            if (t >= 1) {
                // Finalize piece placement, castling rook movement, or promotion transformation
                anim.attackerMesh.position.copy(anim.targetPos);
                anim.attackerMesh.position.y = 0;
                anim.attackerMesh.userData.bodyGroup.rotation.set(0, 0, 0);

                delete pieceMeshes[anim.moveObj.from];
                pieceMeshes[anim.moveObj.to] = anim.attackerMesh;
                anim.attackerMesh.userData.square = anim.moveObj.to;

                // Handle Castling Rook Glide
                if (anim.moveObj.flags.includes('k') || anim.moveObj.flags.includes('q')) {
                    const rank = anim.moveObj.color === 'w' ? '1' : '8';
                    const rookFrom = anim.moveObj.flags.includes('k') ? `h${rank}` : `a${rank}`;
                    const rookTo = anim.moveObj.flags.includes('k') ? `f${rank}` : `d${rank}`;
                    const rookMesh = pieceMeshes[rookFrom];
                    if (rookMesh) {
                        rookMesh.position.copy(squareToWorld(rookTo));
                        delete pieceMeshes[rookFrom];
                        pieceMeshes[rookTo] = rookMesh;
                        rookMesh.userData.square = rookTo;
                    }
                }

                // Handle Pawn Promotion Sculptural Transfiguration
                if (anim.moveObj.flags.includes('p')) {
                    piecesGroup.remove(anim.attackerMesh);
                    const promotedMesh = createSculptedPiece(anim.moveObj.promotion, anim.moveObj.color);
                    promotedMesh.position.copy(anim.targetPos);
                    promotedMesh.userData.square = anim.moveObj.to;
                    piecesGroup.add(promotedMesh);
                    pieceMeshes[anim.moveObj.to] = promotedMesh;
                }

                currentActionAnim = null;
                isAnimating = false;
                onTurnCompleted(anim.moveObj);
            }
        }

        function showBattleToast(move) {
            const names = { p: 'Pawn', r: 'Rook', n: 'Knight', b: 'Bishop', q: 'Queen', k: 'King' };
            const attackerSide = move.color === 'w' ? 'Marble' : 'Obsidian';
            const defenderSide = move.color === 'w' ? 'Obsidian' : 'Marble';
            const toast = document.getElementById('battle-toast');
            toast.textContent = `${attackerSide} ${names[move.piece]} shatters ${defenderSide} ${names[move.captured]} on ${move.to.toUpperCase()}!`;
            toast.classList.remove('hidden');
            clearTimeout(toast.hideTimer);
            toast.hideTimer = setTimeout(() => toast.classList.add('hidden'), 3200);
        }

        function onTurnCompleted(lastMove) {
            updateUIStatus(lastMove);
            renderSquareHighlights();

            if (chess.game_over()) {
                playSound('victory');
                showGameOverModal();
                return;
            }

            if (chess.in_check()) {
                playSound('check');
            }

            // If playing vs Wizard Automaton and it's Black's turn, schedule AI move
            if (vsAI && chess.turn() === 'b' && !chess.game_over()) {
                setTimeout(makeWizardAIMove, 520);
            }
        }

        /***********************************************************************
         * 9. WIZARD AUTOMATON AI (MINIMAX + POSITIONAL EVALUATION)
         ***********************************************************************/
        const PIECE_VALUES = { p: 100, n: 320, b: 330, r: 500, q: 900, k: 20000 };

        function evaluateBoardState(gameInstance) {
            if (gameInstance.in_checkmate()) {
                return gameInstance.turn() === 'w' ? -99999 : 99999;
            }
            if (gameInstance.in_draw()) return 0;

            const board = gameInstance.board();
            let score = 0;
            for (let r = 0; r < 8; r++) {
                for (let f = 0; f < 8; f++) {
                    const piece = board[r][f];
                    if (piece) {
                        const baseVal = PIECE_VALUES[piece.type] || 0;
                        // Bonus for center control (d4, e4, d5, e5)
                        const centerBonus = (r >= 2 && r <= 5 && f >= 2 && f <= 5) ? 18 : 0;
                        const total = baseVal + centerBonus;
                        score += piece.color === 'w' ? total : -total;
                    }
                }
            }
            return score;
        }

        function makeWizardAIMove() {
            if (chess.game_over() || chess.turn() !== 'b') return;
            const legalMoves = chess.moves({ verbose: true });
            if (legalMoves.length === 0) return;

            // Prioritize captures and center development with 2-ply lookahead
            let bestMove = legalMoves[0];
            let bestScore = Infinity; // Black minimizes score

            // Shuffle slightly for variety
            legalMoves.sort(() => Math.random() - 0.5);

            for (const move of legalMoves) {
                chess.move(move);
                let replyWorstForBlack = -Infinity;
                const whiteReplies = chess.moves({ verbose: true });

                if (whiteReplies.length === 0) {
                    replyWorstForBlack = evaluateBoardState(chess);
                } else {
                    // Sample top responses
                    for (let i = 0; i < Math.min(whiteReplies.length, 14); i++) {
                        chess.move(whiteReplies[i]);
                        const evalScore = evaluateBoardState(chess);
                        if (evalScore > replyWorstForBlack) replyWorstForBlack = evalScore;
                        chess.undo();
                    }
                }
                chess.undo();

                // Slight preference for dramatic captures in Wizard's Chess
                if (move.flags.includes('c')) replyWorstForBlack -= 35;

                if (replyWorstForBlack < bestScore) {
                    bestScore = replyWorstForBlack;
                    bestMove = move;
                }
            }

            executeAnimatedMove(bestMove);
        }

        /***********************************************************************
         * 10. UI CONTROLS, SINGLE-LEVEL NAVIGATION & MOVE LOG
         ***********************************************************************/
        function updateUIStatus(lastMove) {
            const turn = chess.turn();
            const swatch = document.getElementById('turn-swatch');
            const statusText = document.getElementById('status-text');

            if (turn === 'w') {
                swatch.className = 'w-4 h-4 rounded-full bg-stone-100 border-2 border-amber-300 shadow-[0_0_10px_rgba(255,255,255,0.8)] transition-all duration-300';
                statusText.textContent = chess.in_check() ? "White Marble in CHECK!" : "White Marble's Turn";
            } else {
                swatch.className = 'w-4 h-4 rounded-full bg-indigo-950 border-2 border-purple-400 shadow-[0_0_10px_rgba(168,85,247,0.8)] transition-all duration-300';
                statusText.textContent = chess.in_check()
                    ? "Dark Obsidian in CHECK!"
                    : (vsAI ? "Obsidian Automaton Pondering..." : "Dark Obsidian's Turn");
            }

            const topBar = swatch.parentElement.parentElement;
            if (chess.in_check()) {
                topBar.classList.add('check-alert');
            } else {
                topBar.classList.remove('check-alert');
            }

            // Update Captured Counters
            document.getElementById('captured-w').textContent = capturedCounts.w;
            document.getElementById('captured-b').textContent = capturedCounts.b;

            // Update Move Chronicle
            const history = chess.history({ verbose: true });
            document.getElementById('move-count-badge').textContent = `${Math.ceil(history.length / 2)} turns`;
            const listEl = document.getElementById('move-list');

            if (history.length === 0) {
                listEl.innerHTML = `<div class="text-gray-500 italic py-4 text-center font-sans">Select any glowing marble piece to begin the duel.</div>`;
                return;
            }

            let html = '';
            for (let i = 0; i < history.length; i += 2) {
                const moveNumber = Math.floor(i / 2) + 1;
                const wMove = history[i];
                const bMove = history[i + 1];
                const wCap = wMove.captured ? '⚔️' : '';
                const bCap = bMove && bMove.captured ? '⚔️' : '';

                html += `
                    <div class="flex items-center justify-between px-2.5 py-1 rounded-lg ${i + 2 >= history.length ? 'bg-purple-500/15 text-white' : 'hover:bg-white/5'}">
                        <span class="text-gray-500 w-8">${moveNumber}.</span>
                        <span class="flex-1 text-amber-100">${wMove.san} ${wCap}</span>
                        <span class="flex-1 text-purple-200">${bMove ? bMove.san + ' ' + bCap : ''}</span>
                    </div>
                `;
            }
            listEl.innerHTML = html;
            listEl.scrollTop = listEl.scrollHeight;

            // In 2-Player mode, optionally auto-rotate camera if user set camera to auto
            if (!vsAI && cameraPresetIndex === 0) {
                camSpherical.targetTheta = turn === 'w' ? 0 : Math.PI;
            }
        }

        function resetGame() {
            closeGameOverModal();
            chess.reset();
            selectedSquare = null;
            legalMovesForSelected = [];
            currentActionAnim = null;
            isAnimating = false;
            capturedCounts = { w: 0, b: 0 };

            syncBoardFromFEN();
            clearSquareHighlights();
            updateUIStatus();
            playSound('select');

            if (cameraPresetIndex === 0) {
                camSpherical.targetTheta = 0;
                camSpherical.targetPhi = 0.92;
                camSpherical.targetRadius = 25.5;
            }
        }

        function cycleCameraPreset() {
            cameraPresetIndex = (cameraPresetIndex + 1) % 4;
            const label = document.getElementById('camera-label');
            playSound('select');

            if (cameraPresetIndex === 0) {
                label.textContent = 'White View';
                camSpherical.targetTheta = 0;
                camSpherical.targetPhi = 0.92;
                camSpherical.targetRadius = 25.5;
            } else if (cameraPresetIndex === 1) {
                label.textContent = 'Black View';
                camSpherical.targetTheta = Math.PI;
                camSpherical.targetPhi = 0.92;
                camSpherical.targetRadius = 25.5;
            } else if (cameraPresetIndex === 2) {
                label.textContent = 'Cathedral Nave';
                camSpherical.targetTheta = Math.PI / 4;
                camSpherical.targetPhi = 1.05;
                camSpherical.targetRadius = 29.0;
            } else {
                label.textContent = 'Top Sanctum';
                camSpherical.targetTheta = 0;
                camSpherical.targetPhi = 0.22;
                camSpherical.targetRadius = 27.5;
            }
        }

        function toggleGameMode() {
            vsAI = !vsAI;
            const btn = document.getElementById('btn-mode');
            const icon = document.getElementById('mode-icon');
            const label = document.getElementById('mode-label');
            const badge = document.getElementById('mode-badge');

            playSound('select');

            if (vsAI) {
                btn.classList.add('md-btn-active');
                icon.textContent = 'smart_toy';
                label.textContent = 'vs Wizard AI';
                badge.textContent = 'vs Automaton';
                if (chess.turn() === 'b' && !chess.game_over() && !isAnimating) {
                    setTimeout(makeWizardAIMove, 400);
                }
            } else {
                btn.classList.remove('md-btn-active');
                icon.textContent = 'group';
                label.textContent = '2-Player Pass';
                badge.textContent = '2P Sanctuary Duel';
            }
            updateUIStatus();
        }

        function triggerTacticalHint() {
            if (isAnimating || chess.game_over()) return;
            const moves = chess.moves({ verbose: true });
            if (moves.length === 0) return;

            // Find a capture move if available, otherwise a strong central move
            const captureMove = moves.find(m => m.flags.includes('c'));
            const suggested = captureMove || moves[Math.floor(Math.random() * moves.length)];

            selectedSquare = suggested.from;
            legalMovesForSelected = [suggested];
            playSound('select');
            renderSquareHighlights();

            const toast = document.getElementById('battle-toast');
            toast.textContent = `Arcane Counsel: Move ${suggested.from.toUpperCase()} → ${suggested.to.toUpperCase()}`;
            toast.classList.remove('hidden');
            clearTimeout(toast.hideTimer);
            toast.hideTimer = setTimeout(() => toast.classList.add('hidden'), 2800);
        }

        function toggleLogDrawer() {
            const drawer = document.getElementById('log-drawer');
            const btn = document.getElementById('btn-log');
            const isOpen = !drawer.classList.contains('pointer-events-none');
            playSound('select');

            if (isOpen) {
                drawer.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
                btn.classList.remove('md-btn-active');
            } else {
                drawer.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
                btn.classList.add('md-btn-active');
            }
        }

        function showGameOverModal() {
            const modal = document.getElementById('gameover-modal');
            const title = document.getElementById('gameover-title');
            const desc = document.getElementById('gameover-desc');

            if (chess.in_checkmate()) {
                const winner = chess.turn() === 'w' ? 'Dark Obsidian' : 'White Marble';
                title.textContent = 'Checkmate';
                desc.textContent = `${winner} commands the Gothic Cathedral Sanctuary in decisive victory!`;
            } else {
                title.textContent = 'Sanctuary Stalemate';
                desc.textContent = 'Neither Marble nor Obsidian yields. The match concludes in a draw.';
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeGameOverModal() {
            const modal = document.getElementById('gameover-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        /***********************************************************************
         * 11. INTERACTIVE POINTER, TOUCH & ORBIT CAMERA CONTROLS
         ***********************************************************************/
        function bindViewportEvents(domElement) {
            domElement.addEventListener('pointerdown', e => {
                isDragging = true;
                dragMoved = false;
                pointerDownPos = { x: e.clientX, y: e.clientY };
                prevPointerPos = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('pointermove', e => {
                if (!isDragging) return;
                const dx = e.clientX - prevPointerPos.x;
                const dy = e.clientY - prevPointerPos.y;

                if (Math.hypot(e.clientX - pointerDownPos.x, e.clientY - pointerDownPos.y) > 6) {
                    dragMoved = true;
                }

                camSpherical.targetTheta -= dx * 0.0075;
                camSpherical.targetPhi = Math.max(0.18, Math.min(1.42, camSpherical.targetPhi - dy * 0.0065));
                prevPointerPos = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('pointerup', e => {
                if (!isDragging) return;
                isDragging = false;
                if (!dragMoved) {
                    handleBoardRaycast(e.clientX, e.clientY);
                }
            });

            domElement.addEventListener('wheel', e => {
                e.preventDefault();
                camSpherical.targetRadius = Math.max(14, Math.min(42, camSpherical.targetRadius + e.deltaY * 0.018));
            }, { passive: false });
        }

        function handleBoardRaycast(clientX, clientY) {
            mouse.x = (clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(clientY / window.innerHeight) * 2 + 1;
            raycaster.setFromCamera(mouse, camera);

            // Check intersection with pieces first, then board squares
            const pieceObjects = [];
            piecesGroup.traverse(obj => {
                if (obj.isMesh) pieceObjects.push(obj);
            });

            const pieceHits = raycaster.intersectObjects(pieceObjects, false);
            if (pieceHits.length > 0) {
                let node = pieceHits[0].object;
                while (node && !node.userData.square) {
                    node = node.parent;
                }
                if (node && node.userData.square) {
                    onSquareClicked(node.userData.square);
                    return;
                }
            }

            const tileObjects = Object.values(squareMeshes);
            const tileHits = raycaster.intersectObjects(tileObjects, false);
            if (tileHits.length > 0) {
                const sq = tileHits[0].object.userData.square;
                if (sq) onSquareClicked(sq);
            }
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        /***********************************************************************
         * 12. MAIN RENDER & IDLE ANIMATION LOOP
         * Animates custom piece idle levitation/breathing, stained glass light
         * shimmer, move/attack sequences, and shatter physics.
         ***********************************************************************/
        let lastFrameTime = performance.now();

        function animateLoop(now = performance.now()) {
            requestAnimationFrame(animateLoop);
            const dt = Math.min(0.05, (now - lastFrameTime) / 1000);
            lastFrameTime = now;
            const elapsedSec = now * 0.001;

            // 1. Smoothly interpolate Orbit Camera
            camSpherical.theta += (camSpherical.targetTheta - camSpherical.theta) * 0.09;
            camSpherical.phi += (camSpherical.targetPhi - camSpherical.phi) * 0.09;
            camSpherical.radius += (camSpherical.targetRadius - camSpherical.radius) * 0.09;

            camera.position.x = camSpherical.radius * Math.sin(camSpherical.phi) * Math.sin(camSpherical.theta);
            camera.position.y = camSpherical.radius * Math.cos(camSpherical.phi);
            camera.position.z = camSpherical.radius * Math.sin(camSpherical.phi) * Math.cos(camSpherical.theta);
            camera.lookAt(camSpherical.lookAt);

            // 2. Custom Idle Breathing & Crown/Halo Levitation on all 32 Pieces
            Object.values(pieceMeshes).forEach(piece => {
                const ud = piece.userData;
                if (ud.floatingHalo) {
                    ud.floatingHalo.position.y = ud.baseHaloY + Math.sin(elapsedSec * 2.4 + ud.phaseOffset) * 0.08;
                    if (ud.type === 'q' || ud.type === 'b' || ud.type === 'r') {
                        ud.floatingHalo.rotation.y += dt * 0.85;
                    }
                }
                // Highlighted pulse if selected
                if (selectedSquare && ud.square === selectedSquare) {
                    piece.position.y = 0.22 + Math.sin(elapsedSec * 5) * 0.08;
                } else if (!currentActionAnim || currentActionAnim.attackerMesh !== piece) {
                    piece.position.y = 0;
                }
            });

            // 3. Subtle Stained Glass Cathedral Light Shimmer
            stainedGlassLights.forEach((light, idx) => {
                light.intensity = 1.15 + Math.sin(elapsedSec * 1.3 + idx * 2.1) * 0.22;
            });

            // 4. Update Move / Attack / Shatter Sequences
            updateActiveMoveAnimation(dt);
            updateParticlesAndPhysics(dt);

            renderer.render(scene, camera);
        }

        // Start Application on Window Load
        window.onload = function () {
            initThreeScene();
            syncBoardFromFEN();
            updateUIStatus();
            animateLoop();
        };
    </script>
